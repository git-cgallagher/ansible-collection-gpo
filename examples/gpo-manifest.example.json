{
  "domain": "lab.example.com",
  "netbios": "LAB",
  "root_dn": "DC=lab,DC=example,DC=com",
  "domain_sid": "S-1-5-21-1111111111-2222222222-3333333333",
  "gpos": {
    "CFG - RDP Settings": {
      "backup_dir": "CFG - RDP Settings",
      "status": "UserSettingsDisabled",
      "wmi_filter": null,
      "apply_to": [
        { "name": "Authenticated Users", "type": "Group" }
      ],
      "denied": []
    },
    "SEC - Domain Password Policy": {
      "backup_dir": "SEC - Domain Password Policy",
      "status": "AllSettingsEnabled",
      "wmi_filter": null,
      "apply_to": [
        { "name": "Authenticated Users", "type": "Group" }
      ],
      "denied": []
    },
    "SEC - Server Baseline": {
      "backup_dir": "SEC - Server Baseline",
      "status": "AllSettingsEnabled",
      "wmi_filter": "Server OS only",
      "apply_to": [
        { "name": "GG-Servers-Prod", "type": "Group" }
      ],
      "denied": [
        { "name": "GG-Tier0-Admins", "type": "Group", "permission": "GpoApply" }
      ]
    }
  },
  "wmi_filters": {
    "Server OS only": {
      "description": "Member servers and DCs, not workstations",
      "namespace": "root\\CIMv2",
      "query": "SELECT * FROM Win32_OperatingSystem WHERE ProductType > 1",
      "raw_parm2": "1;3;10;57;WQL;root\\CIMv2;SELECT * FROM Win32_OperatingSystem WHERE ProductType > 1;"
    }
  },
  "soms": [
    {
      "target": "",
      "block_inheritance": false,
      "links": [
        { "gpo": "SEC - Domain Password Policy", "enforced": false, "enabled": true },
        { "gpo": "Default Domain Policy", "enforced": false, "enabled": true }
      ]
    },
    {
      "target": "OU=Servers",
      "block_inheritance": false,
      "links": [
        { "gpo": "SEC - Server Baseline", "enforced": true, "enabled": true },
        { "gpo": "CFG - RDP Settings", "enforced": false, "enabled": true }
      ]
    }
  ]
}
